# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_sales_coach

# Storage (MinIO / OSS)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-sales-coach
STORAGE_PUBLIC_URL=http://localhost:3000

# ASR
ASR_ENGINE=aliyun
ASR_APP_KEY=your-app-key
ASR_ACCESS_KEY_ID=your-access-key-id
ASR_ACCESS_KEY_SECRET=your-access-key-secret
ASR_REGION=cn-shanghai
ASR_ENDPOINT=filetrans.cn-shanghai.aliyuncs.com

# Development flag: set to true when audio_url is localhost (Aliyun cannot reach localhost)
MOCK_ASR=true

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://yunwu.ai

# JWT
JWT_SECRET=change-this-in-production

# Retry & Timeout
ASR_TIMEOUT_MS=30000
ASR_MAX_RETRIES=1
