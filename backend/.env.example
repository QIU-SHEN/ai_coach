# =============================================================================
# Server
# =============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# Database (MySQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_sales_coach

# =============================================================================
# CORS
# =============================================================================
# Comma-separated origins, e.g. http://localhost:5173,http://127.0.0.1:5173
# Leave empty to use defaults: localhost:5173, localhost:5174, qiushen.top
CORS_ORIGINS=

# =============================================================================
# JWT
# =============================================================================
# REQUIRED — server will not start without this
JWT_SECRET=change-this-to-a-random-string
# Default: 7d. Accepts vercel/ms format: 1h, 7d, 30d, etc.
JWT_EXPIRES_IN=7d

# =============================================================================
# AI / LLM
# =============================================================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://yunwu.ai

# =============================================================================
# OSS Storage (Alibaba Cloud)
# =============================================================================
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_PUBLIC_URL=https://your-bucket.oss-cn-shanghai.aliyuncs.com

# =============================================================================
# ASR (Speech Recognition)
# =============================================================================
ASR_ENGINE=aliyun
ASR_APP_KEY=your-app-key
ASR_ACCESS_KEY_ID=your-access-key-id
ASR_ACCESS_KEY_SECRET=your-access-key-secret
ASR_REGION=cn-shanghai
ASR_ENDPOINT=filetrans.cn-shanghai.aliyuncs.com
ASR_TIMEOUT_MS=30000
ASR_MAX_RETRIES=1
# Set to true when running locally (Aliyun cannot reach localhost audio URLs)
MOCK_ASR=true
# Optional: local Whisper server URL
LOCAL_WHISPER_URL=http://localhost:8178

# =============================================================================
# SMTP (Email — password reset)
# =============================================================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=AI Sales Coach <your-email@qq.com>

# =============================================================================
# Frontend (for password reset links, etc.)
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Sentry (optional — error monitoring)
# =============================================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# Backup (mysqldump)
# =============================================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
