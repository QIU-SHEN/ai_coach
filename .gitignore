# =============================================================================
# AI 销售陪练系统 — Git 忽略规则
# 设计目标：可以直接 `git add frontend/` `git add backend/` 而无需手动挑选
# =============================================================================

# ============================================================================
# 全局通用忽略
# ============================================================================

# 环境配置（敏感信息）
.env
.env.*
!.env.example

# 依赖目录
node_modules/
vendor/

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 日志和缓存
logs/
cache/
tmp/
runtime/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编译产物（通用）
dist/
dist-ssr/
*.pyc
*.pyo
*.cache
*.local

# 备份文件
src-backup-*/
*.backup
*.bak

# ============================================================================
# 前端 (frontend/)
# ============================================================================

# 编译产物
frontend/dist/
frontend/dist-ssr/

# 依赖
frontend/node_modules/

# 环境配置
frontend/.env*
!frontend/.env.example

# 本地缓存
frontend/*.local

# ============================================================================
# 后端 (backend/)
# ============================================================================

# 依赖
backend/node_modules/

# 编译产物
backend/dist/

# 环境配置（绝不要提交真实密钥）
backend/.env
backend/.env.*
!backend/.env.example

# 上传的用户文件
backend/uploads/

# 测试音频文件
backend/*.wav
backend/*.mp3
backend/*.m4a
backend/*.webm

# 临时/生成文件
backend/tmp_*.txt
generated-*.txt
backend/check_db.js

# 数据库导出（敏感）
*.sql

# ============================================================================
# 根目录特殊文件
# ============================================================================

# 数据库备份
ai_sales_coach.sql

# 本地修改备忘（可提交，但看个人习惯）
# LOCAL_CHANGES.md

# 中文目录（产品资料原始文件，体积大，不应提交）
辅助员工提升销售能力AI员工/
